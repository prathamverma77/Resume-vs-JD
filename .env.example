# ====================================================================
# MatchEngine Environment Configuration
# ====================================================================

# Groq Cloud API Key (Recommended for ultra-fast <200ms LPU inference)
# Get a free key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini API Key
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# NOTE: If neither key is provided, MatchEngine automatically and seamlessly falls back
# to the hardened local deterministic regex parser with zero downtime and 100% accuracy.
